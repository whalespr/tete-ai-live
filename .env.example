# TETE AI — Live Website — Environment Variables
# Add these in Vercel: Project → Settings → Environment Variables
# (Never commit real keys to git — they stay server-side only)

# The Odds API — free 500 req/month
# Get it at https://the-odds-api.com (sign up → API key)
ODDS_API_KEY=

# API-Football — free 100 req/day (used later for deeper team history)
# Get it at https://www.api-football.com → api-sports.io
API_FOOTBALL_KEY=
API_FOOTBALL_HOST=v3.football.api-sports.io
